# Names only. Copy to .env and fill in the values on your machine; never commit them.

# TEST key (starts with glk_test_) issued by the towing company you work with.
GRUALINK_API_KEY=

# Signing secret for webhooks (starts with whsec_). Use it whole, prefix included.
GRUALINK_WEBHOOK_SECRET=

# Optional: previous signing secret, only while a rotation is in progress.
GRUALINK_WEBHOOK_SECRET_PREVIOUS=

# Optional: port for the example webhook server (default 8787).
PORT=

# Optional: override the API base URL (default https://grualink.mx/api/v1).
GRUALINK_API_BASE_URL=
